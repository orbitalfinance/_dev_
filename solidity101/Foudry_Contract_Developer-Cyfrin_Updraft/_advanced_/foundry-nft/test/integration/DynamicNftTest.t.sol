pragma solidity ^0.8.30;

import {DynamicNft} from "../../src/DynamicNft.sol";
import {Test, console} from "../../lib/forge-std/src/Test.sol";
import {DeployDynamicNft} from "../../script/DeployDynamicNft.s.sol";

contract DynamicNftTest is Test {
    DynamicNft dynamicNft;

    string public constant RED_SVG_IMAGE_URI =
        "data:image/svg+xml;base64,";
    string public constant GREEN_SVG_IMAGE_URI =
        "data:image/svg+xml;base64,";

    string public constant GREEN_SVG_URI =
        "data:application/json;base64,";

    DeployDynamicNft deployer;
    address USER = makeAddr("user");

    function setUp() public {
        deployer = new DeployDynamicNft();
        dynamicNft = deployer.run();
    }

    function testViewTokenUriIntegration() public {
        vm.prank(USER);
        dynamicNft.mintNft();
        console.log(dynamicNft.tokenURI(0));
    }

    function testFlipTokenToGreen() public {
        vm.prank(USER);
        dynamicNft.mintNft();

        vm.prank(USER);
        dynamicNft.changeColor(0);

        console.log(dynamicNft.tokenURI(0));
        assert(
            keccak256(abi.encodePacked(dynamicNft.tokenURI(0))) ==
                keccak256(abi.encodePacked(GREEN_SVG_URI))
        );
    }
}
